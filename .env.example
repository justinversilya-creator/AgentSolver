# .env.example
# Copy this file to .env and fill in real values. Never commit .env.

# Full HTTPS webhook URL of your Make.com scenario (Custom webhook module).
MAKE_WEBHOOK_URL=

# Optional shared secret. Sent to Make.com in the X-AgentSolve-Token header.
# Add a matching filter in the Make.com scenario after the webhook.
MAKE_WEBHOOK_SECRET=

# Comma-separated list of frontend origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Read timeout for the Make.com scenario response, in seconds (0 < value <= 600).
REQUEST_TIMEOUT_SECONDS=120

# true = return clearly labeled illustrative data without calling Make.com.
DEMO_MODE=false